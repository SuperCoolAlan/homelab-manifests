# ============================================================================
# STAGED FOR PHASE 4 — NOT WIRED INTO kustomization.yaml
# ============================================================================
# Replaces the TrueNAS NFS PV once ST6000NM0095-pool1 is imported on ramhaus as
# `media` at /var/mnt/media.
#
# The current PV points at
#   /mnt/ST6000NM0095-pool0/media/nfs/v/pvc-e20276d2-8916-47cf-81af-fd75826d5cf0
# but that path is a mountpoint ALIAS - the dataset physically lives at
#   ST6000NM0095-pool1/pool0-evac/media/nfs/v/pvc-e20276d2-...
# (the pool0 evacuation moved the data onto pool1 and re-exported it at the old
# paths). So it travels with the disks; no separate copy is needed.
#
# After import it is reachable at:
#   /var/mnt/media/pool0-evac/media/nfs/v/pvc-e20276d2-8916-47cf-81af-fd75826d5cf0
#
# A PV's source and a PVC's volumeName are both immutable, so both objects have
# to be deleted and recreated. Both are Retain, so no data is touched.
#
# ⚠️ tracearr has been in CrashLoopBackOff for days on:
#     chown: changing ownership of '/data/postgres': Operation not permitted
# That is an fsGroup/permissions problem with NFS. Moving to a local: PV may fix
# it outright, since the ownership semantics differ - but if it persists, the
# better answer is migrating this to fast-array like the other app configs
# rather than keeping it on the media pool at all. It is only 10Gi.
# ============================================================================
apiVersion: v1
kind: PersistentVolume
metadata:
  name: tracearr-data-local
spec:
  capacity:
    storage: 10Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: media-local
  local:
    path: /var/mnt/media/pool0-evac/media/nfs/v/pvc-e20276d2-8916-47cf-81af-fd75826d5cf0
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - talos-ramhaus
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: tracearr-data
  namespace: tracearr
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: media-local
  volumeName: tracearr-data-local
  resources:
    requests:
      storage: 10Gi
