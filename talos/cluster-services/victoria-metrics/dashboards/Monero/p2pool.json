          "expr": "max(p2pool_miner_hashrate{namespace=\"p2pool\"}) / (max(p2pool_network_difficulty{namespace=\"p2pool\"}) / 120) * 720 * max(p2pool_network_reward_atomic{namespace=\"p2pool\"}) / 1e12",
          "legendFormat": "XMR/day",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
