    {
      "id": 8,
      "type": "timeseries",
      "title": "Schedule & CPU clock (turbo proxy)",
      "description": "Clock drops to ~3.2 GHz base while turbo-off runs (i.e. while mining).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(node_cpu_scaling_frequency_hertz{instance=\"10.0.1.12:9100\"})",
          "legendFormat": "ramhaus avg core clock",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(kube_deployment_spec_replicas{namespace=\"p2pool\",deployment=\"p2pool\"})",
          "legendFormat": "p2pool replicas",
          "refId": "B"
