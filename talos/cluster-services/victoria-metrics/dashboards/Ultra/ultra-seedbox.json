{
  "uid": "ultra-seedbox",
  "title": "Ultra Seedbox",
  "description": "One-month Ultra.cc seedbox: upload against the 2 TB cap, disk against the quota, autobrr grabs, and per-torrent earnings.",
  "tags": [
    "seedbox",
    "qbittorrent",
    "autobrr"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
