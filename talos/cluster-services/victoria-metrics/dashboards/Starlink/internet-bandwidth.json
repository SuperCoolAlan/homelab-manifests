          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(opnsense_interfaces_transmitted_bytes_total{interface!=\"WAN\"}[$__rate_interval])*8",
          "legendFormat": "{{interface}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Cluster",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Node NIC throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{device=~\"eno1|end0\"}[$__rate_interval])*8",
          "legendFormat": "{{instance}} {{device}} rx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "-rate(node_network_transmit_bytes_total{device=~\"eno1|end0\"}[$__rate_interval])*8",
          "legendFormat": "{{instance}} {{device}} tx"
        }
      ],
      "description": "Physical NICs, includes LAN traffic such as NFS to TrueNAS. Transmit is drawn below zero."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Top pods by upload",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(10, sum by (namespace, pod) (rate(container_network_transmit_bytes_total{interface=\"eth0\",pod!=\"\"}[$__rate_interval])))*8",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "description": "Pod-network interfaces only; host-network pods (cilium, metallb, node-exporter) report the whole node and are excluded."
    },
