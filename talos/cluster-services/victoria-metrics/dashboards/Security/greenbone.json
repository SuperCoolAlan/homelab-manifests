        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(max by (host, hostname) (greenbone_host_max_severity))",
