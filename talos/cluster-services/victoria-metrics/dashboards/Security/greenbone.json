          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (task) (greenbone_task_last_scan_end_timestamp_seconds) * 1000",
          "instant": true,
          "format": "table",
          "refId": "D"
