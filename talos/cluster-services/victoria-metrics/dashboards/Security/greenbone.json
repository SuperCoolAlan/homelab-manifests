            "renameByName": {
              "task": "Task",
              "status": "Status",
              "Value #B": "Progress %",
              "Value #C": "Hosts alive",
              "Value #D": "Last scan finished"
            },
            "indexByName": {
              "task": 0,
              "status": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            }
          }
        }
