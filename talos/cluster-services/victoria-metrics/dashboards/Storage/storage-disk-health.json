{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Disk health, liveness and I/O for the Talos nodes. Built 2026-08-10 after the TrueNAS decommission, when the `fast` pool was found DEGRADED with two SATA SSDs missing - a failure that produced zero ZFS errors and no alert. The Health & liveness row exists to make that state impossible to miss.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Health & liveness",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "ZFS pool state",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 = ONLINE. Anything else means at least one vdev is not healthy.\n\nThis is the panel that would have caught the `fast` pool losing both SATA SSDs on 2026-08-10: the pool kept serving I/O with zero errors, so nothing else flagged it until a reboot.",
      "gridPos": {
        "h": 5,
        "w": 7,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "NOT ONLINE"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "ONLINE"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 42
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "node_zfs_zpool_state{state=\"online\"}",
          "legendFormat": "{{zpool}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pool states in fault",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Sum of every non-online pool state flag across all pools. 0 is the only good value.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 7,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 42
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(node_zfs_zpool_state{state=~\"degraded|faulted|offline|removed|suspended|unavail\"})",
          "legendFormat": "faulted state-flags",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Block devices present",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Physical block devices node-exporter can see, excluding loop/dm/zvol.\n\nLIVENESS SIGNAL: a drive that drops off the bus stops producing series entirely - it does not report an error, it simply disappears. Watch for this number falling. It went 13 -> 11 on 2026-08-10 when two SATA SSDs failed to initialise after a reboot (ata5/ata6 hardreset failed).",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 13,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 11
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 42
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(node_disk_info{device!~\"loop.*|dm-.*|zd.*\"})",
          "legendFormat": "devices",
          "range": false,
          "instant": true,
          "refId": "C"
        }
      ]
    },
    {
