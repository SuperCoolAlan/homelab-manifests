    {
      "id": 16,
      "type": "state-timeline",
      "title": "Switch state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(homeassistant_switch_state{entity!~\".*_(led|pulse)\"}, \"plug\", \"$1\", \"friendly_name\", \"(.*?)( 1)?$\")",
          "legendFormat": "{{plug}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
