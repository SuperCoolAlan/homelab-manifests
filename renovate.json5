{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],

  // Vendored helm chart caches (kustomize --enable-helm pulls into charts/).
  // Never let Renovate touch these — CI re-vendors them on each PR.
  ignorePaths: ['**/charts/**'],

  // kustomize: bumps helmCharts[].version in kustomization.yaml files
  // custom.regex: bumps image tags annotated with "# renovate:" comments
  // github-actions: keeps CI workflow actions pinned & current
  enabledManagers: ['kustomize', 'custom.regex', 'github-actions'],

  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  labels: ['dependencies'],

  packageRules: [
    {
      matchManagers: ['kustomize'],
      addLabels: ['helm-chart'],
      commitMessageTopic: 'helm chart {{depName}}',
    },
    {
      // kubectl must stay within one minor of the cluster (1.33); bump this ceiling with the cluster, not before.
      matchPackageNames: ['registry.k8s.io/kubectl'],
      allowedVersions: '<1.34.0',
    },
    {
      // linuxserver published an ancient 20.04.1 tag that docker versioning ranks above 5.x; it is a downgrade.
      matchPackageNames: ['linuxserver/qbittorrent'],
      allowedVersions: '<20',
    },
    {
      // UniFi 10 bundles MongoDB 8, which can't open this controller's older database in place; needs a backup/restore migration first.
      matchPackageNames: ['goofball222/unifi'],
      allowedVersions: '<10',
    },
    {
      // Majors get their own PR and a loud label — read the release notes
      // in the PR body before merging these.
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },
    {
      // The servarr charts all come from the same repo and rev together
      matchManagers: ['kustomize'],
      matchFileNames: ['talos/media-v2/**'],
      groupName: 'media-servarr charts',
      matchUpdateTypes: ['minor', 'patch'],
    },
  ],

  customManagers: [
    {
      // Matches values files containing:
      //   # renovate: datasource=docker depName=<org>/<image>
      //   tag: "1.2.3"
      customType: 'regex',
      managerFilePatterns: ['/values.*\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s*\\n\\s*tag:\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}',
    },
    {
      // Same annotation, but for raw manifests that set a full `image:` ref
      // rather than a chart `tag:` value (e.g. talos/monerod/statefulset.yaml).
      // The `kubernetes` manager stays off on purpose — this keeps bumps opt-in
      // per image instead of scanning every rendered manifest in the tree.
      customType: 'regex',
      managerFilePatterns: ['/talos/.*\\.ya?ml$/'],
      matchStrings: [
        // Non-greedy name so `@sha256:` is never read as part of the tag; digest is optional but must be captured when present or bumps leave it stale.
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\s*\\n\\s*image:\\s*"?\\S+?:(?<currentValue>[^"\\s@]+)(@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}',
    },
  ],
}
